[Unit]
Description=Deskmate OS: the allowed-sites gate for Bots' internet
After=network.target
Before=deskmate-net.service

[Service]
User=deskmate-proxy
Group=deskmate-proxy
ExecStart=/usr/local/sbin/deskmate-proxy
Restart=always
RestartSec=2
LogsDirectory=deskmate-net
LogsDirectoryMode=0755
UMask=0022
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
