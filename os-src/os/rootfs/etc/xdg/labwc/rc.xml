<?xml version="1.0"?>
<labwc_config>
  <core>
    <decoration>server</decoration>
    <gap>0</gap>
  </core>
  <theme>
    <cornerRadius>8</cornerRadius>
    <font name="Noto Sans" size="10" />
  </theme>
  <keyboard>
    <default />
    <keybind key="W-space"><action name="Execute" command="fuzzel" /></keybind>
    <keybind key="W-A-space"><action name="Execute" command="deskmate-menu" /></keybind>
    <keybind key="W-k"><action name="Execute" command="deskmate-menu hotkeys" /></keybind>
    <keybind key="W-d"><action name="Execute" command="deskmate-desktop toggle" /></keybind>
    <keybind key="W-Return"><action name="Execute" command="foot" /></keybind>
    <keybind key="C-A-t"><action name="Execute" command="foot" /></keybind>
    <keybind key="W-b"><action name="Execute" command="chromium" /></keybind>
    <keybind key="W-f"><action name="Execute" command="pcmanfm-qt" /></keybind>
    <keybind key="W-q"><action name="Close" /></keybind>
    <keybind key="W-l"><action name="Execute" command="swaylock -f -c 000000" /></keybind>
    <keybind key="W-C-S-space"><action name="Execute" command="deskmate-menu theme" /></keybind>
    <keybind key="W-C-v"><action name="Execute" command="deskmate-menu clipboard" /></keybind>
    <keybind key="W-Escape"><action name="Execute" command="deskmate-os stop-bots" /></keybind>
    <keybind key="Print"><action name="Execute" command="deskmate-menu screenshot-area" /></keybind>
    <keybind key="S-Print"><action name="Execute" command="deskmate-menu screenshot" /></keybind>
    <keybind key="W-Up"><action name="ToggleMaximize" /></keybind>
    <keybind key="W-Left"><action name="SnapToEdge" direction="left" /></keybind>
    <keybind key="W-Right"><action name="SnapToEdge" direction="right" /></keybind>
  </keyboard>
  <windowRules>
    <windowRule identifier="dmcorner" serverDecoration="no" skipTaskbar="yes" skipWindowSwitcher="yes" ignoreFocusRequest="yes">
      <action name="MoveToEdge" direction="right" snapWindows="no" />
      <action name="MoveToEdge" direction="up" snapWindows="no" />
      <action name="ToggleAlwaysOnTop" />
      <action name="ToggleOmnipresent" />
    </windowRule>
    <windowRule identifier="deskmate" serverDecoration="no" />
  </windowRules>
</labwc_config>
