{
  "layer": "top",
  "position": "bottom",
  "height": 38,
  "spacing": 4,
  "modules-left": ["custom/menu", "custom/files", "custom/browser", "custom/terminal", "wlr/taskbar"],
  "modules-right": ["cpu", "memory", "clock", "custom/power", "custom/deskmate"],
  "custom/menu": { "format": "Apps", "tooltip": false, "on-click": "fuzzel", "on-click-right": "deskmate-menu" },
  "custom/files": { "format": "Files", "tooltip": false, "on-click": "pcmanfm-qt" },
  "custom/browser": { "format": "Browser", "tooltip": false, "on-click": "chromium" },
  "custom/terminal": { "format": "Terminal", "tooltip": false, "on-click": "foot" },
  "wlr/taskbar": { "format": "{app_id}", "tooltip-format": "{title}", "on-click": "activate", "on-click-middle": "close" },
  "cpu": { "format": "CPU {usage}%", "interval": 5, "on-click": "foot -T Monitor btop" },
  "memory": { "format": "Mem {percentage}%", "interval": 10, "on-click": "foot -T Monitor btop" },
  "clock": { "format": "{:%a %b %e  %H:%M}", "tooltip": false },
  "custom/power": { "format": "Power", "tooltip": false, "on-click": "deskmate-menu power" },
  "custom/deskmate": { "format": "Deskmate", "tooltip": false, "on-click": "deskmate-desktop deskmate" }
}
