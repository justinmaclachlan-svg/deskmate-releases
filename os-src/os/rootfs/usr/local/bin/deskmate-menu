#!/bin/sh
# The Deskmate OS menu (Super+Alt+Space): one place for style, setup, Bots,
# security and power. Also: deskmate-menu hotkeys | theme | power | clipboard |
# screenshot | screenshot-area
pick() { fuzzel --dmenu --prompt "$1 " ; }
term() { foot -T "$1" sh -c "$2; echo; echo 'Press Enter to close.'; read _"; }
shot() {
  mkdir -p "$HOME/Pictures"
  f="$HOME/Pictures/screenshot-$(date +%Y%m%d-%H%M%S).png"
  if [ "$1" = area ]; then grim -g "$(slurp)" "$f" || exit 0; else grim "$f"; fi
  wl-copy <"$f"
  command -v notify-send >/dev/null && notify-send "Screenshot saved" "$f"
}
case "$1" in
  ask) # Ask a Bot from anywhere; the answer comes back as a notification.
    q=$(printf '' | pick "Ask a Bot"); [ -n "$q" ] || exit 0
    if [ "$2" = clipboard ]; then
      clip=$(wl-paste --no-newline 2>/dev/null | head -c 6000)
      [ -n "$clip" ] && q="$q

$clip"
    fi
    bots=$(/opt/deskmate/dm call bots.list 2>/dev/null | jq -r '.[] | select(.parentId == null) | .name')
    if [ "$(printf '%s\n' "$bots" | grep -c .)" -gt 1 ]; then b=$(printf '%s\n' "$bots" | pick "Which Bot"); else b="$bots"; fi
    [ -n "$b" ] || { notify-send -a Deskmate "Couldn't ask" "Deskmate isn't running."; exit 0; }
    notify-send -a Deskmate "Asked $b" "The answer will show up here and in Deskmate."
    if a=$(/opt/deskmate/dm send "$b" "$q" 2>&1); then
      notify-send -a Deskmate -t 20000 "$b" "$(printf '%s' "$a" | tail -c 500)"
    else
      notify-send -a Deskmate "$b couldn't answer" "$(printf '%s' "$a" | tail -c 300)"
    fi
    exit 0 ;;
  inbox) # What needs you and what finished, in the launcher.
    pickd=$(/opt/deskmate/dm call inbox.list 2>/dev/null | jq -r '.items[] | "\(.bot.name // "Bot"): \(if .kind == "approval" then "needs your OK: " + .title elif .kind == "stuck" then .title else (.kind + ": " + (.text | .[0:90])) end)"' | pick "Inbox")
    [ -n "$pickd" ] && deskmate-desktop deskmate
    exit 0 ;;
  hotkeys) exec foot -T Hotkeys -W 84x30 less -R /usr/share/deskmate-os/hotkeys.txt ;;
  theme) t=$(deskmate-custom theme list | pick "Theme"); [ -n "$t" ] && deskmate-custom theme set "${t%% *}"; exit 0 ;;
  power)
    case "$(printf 'Lock\nLog out\nRestart\nShut down\n' | pick "Power")" in
      Lock) swaylock -f -c 000000 ;;
      "Log out") labwc --exit ;;
      Restart) systemctl reboot ;;
      "Shut down") systemctl poweroff ;;
    esac; exit 0 ;;
  clipboard) cliphist list | pick "Clipboard" | cliphist decode | wl-copy; exit 0 ;;
  screenshot) shot full; exit 0 ;;
  screenshot-area) shot area; exit 0 ;;
esac
choice=$(cat <<'LIST' | pick "Deskmate OS"
Ask a Bot
Ask a Bot about what's on the clipboard
Inbox: what needs you and what finished
Deskmate
Linux desktop
Apps
Terminal
Files
Browser
Style: theme
Style: font
Style: next background
Style: bar at the top
Style: bar at the bottom
Style: hide or show the bar
Style: night light on or off
Style: back to the defaults
Setup: keys (list)
Setup: install software
Screenshot: area
Screenshot: whole screen
Web app: add a website as an app
Bots: stop everything now
Bots' internet: what they can reach
Bots' internet: lock to AI services
Bots' internet: allow a site
Bots' internet: allow software sites for 30 minutes
Bots' internet: turn off
Bots' internet: open to any site
Bots: share a folder with them
Security: check everything now
Agents: pair one (Grok Bot, Deskmate on the host)
Setup: users
Setup: sign in to Claude Code
Setup: sign in to Codex
Setup: sign in to Gemini
System: update
System: monitor
System: status
Hotkeys
Power
LIST
)
case "$choice" in
  "Ask a Bot") exec "$0" ask ;;
  "Ask a Bot about"*) exec "$0" ask clipboard ;;
  "Inbox:"*) exec "$0" inbox ;;
  Deskmate) deskmate-desktop deskmate ;;
  "Linux desktop") deskmate-desktop linux ;;
  Apps) fuzzel ;;
  Terminal) deskmate-custom open terminal ;;
  Files) deskmate-custom open files ;;
  Browser) deskmate-custom open browser ;;
  "Style: theme") exec "$0" theme ;;
  "Style: font") fnt=$(fc-list : family | sed 's/,.*//' | sort -u | pick "Font"); [ -n "$fnt" ] && deskmate-custom font set "$fnt" ;;
  "Style: next background") deskmate-custom background next || term "Background" "echo 'Add a picture first: deskmate-os background set <picture>'" ;;
  "Style: bar at the top") deskmate-custom bar top ;;
  "Style: bar at the bottom") deskmate-custom bar bottom ;;
  "Style: hide or show the bar") deskmate-custom bar toggle ;;
  "Style: night light on or off") deskmate-custom toggle nightlight ;;
  "Style: back to the defaults") deskmate-custom refresh all ;;
  "Setup: keys (list)") term "Keys" "deskmate-custom keys list; echo; echo 'Change one: deskmate-os keys set W-g <command>'" ;;
  "Setup: install software") p=$(printf '' | pick "Package"); [ -n "$p" ] && term "Install" "deskmate-custom pkg install $(printf '%s' "$p" | tr -cd 'a-z0-9+. -')" ;;
  "Screenshot: area") shot area ;;
  "Screenshot: whole screen") sleep 0.4; shot full ;;
  "Web app:"*)
    n=$(printf '' | pick "Name"); [ -n "$n" ] || exit 0
    u=$(printf 'https://' | pick "Address"); [ -n "$u" ] && deskmate-custom webapp add "$n" "$u" ;;
  "Bots: stop"*) deskmate-os stop-bots ;;
  "Bots' internet: what they can reach") term "Bots' internet" "deskmate-os net" ;;
  "Bots' internet: lock to AI services") term "Bots' internet" "sudo deskmate-os net locked" ;;
  "Bots' internet: allow a site") term "Bots' internet" "printf 'Site to allow (like docs.rs): '; read d && sudo deskmate-os net allow \"\$d\"" ;;
  "Bots' internet: allow software sites for 30 minutes") term "Bots' internet" "sudo deskmate-os net allow packages 30m" ;;
  "Bots' internet: turn off") term "Bots' internet" "sudo deskmate-os net off" ;;
  "Bots' internet: open to any site") term "Bots' internet" "sudo deskmate-os net open" ;;
  "Bots: share"*) d=$(printf '%s\n' "$HOME/Documents" "$HOME/Downloads" | pick "Folder"); [ -n "$d" ] && term "Share" "deskmate-os share '$d'" ;;
  "Security:"*) term "Security" "/opt/deskmate/dm call security.sweep" ;;
  "Agents:"*) term "Pair an agent" "/opt/deskmate/dm pair-code" ;;
  "Setup: sign in to Claude Code") term "Sign in" "deskmate-os login claude" ;;
  "Setup: sign in to Codex") term "Sign in" "deskmate-os login codex" ;;
  "Setup: sign in to Gemini") term "Sign in" "deskmate-os login gemini" ;;
  "Setup: users") term "Users" "sudo deskmate-os users" ;;
  "System: update") term "Update" "sudo deskmate-os update" ;;
  "System: monitor") foot -T Monitor btop ;;
  "System: status") term "Status" "deskmate-os status" ;;
  Hotkeys) exec "$0" hotkeys ;;
  Power) exec "$0" power ;;
esac
