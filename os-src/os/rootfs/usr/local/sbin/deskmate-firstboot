#!/bin/bash
# First start: grow the disk, then set the computer's name, the first person
# (an admin) and root's password. Reads /boot/efi/deskmate-setup.conf when the
# host's setup script left one; asks on screen otherwise.
exec </dev/tty1 >/dev/tty1 2>&1
export TERM=linux NEWT_COLORS='root=,black'
done_file=/var/lib/deskmate-os/setup-done
mkdir -p /var/lib/deskmate-os

# Use the whole disk.
root_dev=$(findmnt -no SOURCE /)
disk="/dev/$(lsblk -no PKNAME "$root_dev")"; part=$(echo "$root_dev" | grep -o '[0-9]*$')
growpart "$disk" "$part" >/dev/null 2>&1; resize2fs "$root_dev" >/dev/null 2>&1
ls /etc/ssh/ssh_host_*_key >/dev/null 2>&1 || ssh-keygen -A >/dev/null 2>&1

conf=/boot/efi/deskmate-setup.conf
HOSTNAME_NEW= ADMIN_USER= ADMIN_PASSWORD= ROOT_PASSWORD= HOST_SSH_KEY=
if [ -f "$conf" ]; then
  get() { sed -n "s/^$1=//p" "$conf" | head -1 | tr -d '\r'; }
  HOSTNAME_NEW=$(get HOSTNAME); ADMIN_USER=$(get ADMIN_USER); ADMIN_PASSWORD=$(get ADMIN_PASSWORD)
  ROOT_PASSWORD=$(get ROOT_PASSWORD); HOST_SSH_KEY=$(get HOST_SSH_KEY)
  shred -u "$conf" 2>/dev/null || rm -f "$conf"
fi
ask() { whiptail --title "Welcome to Deskmate OS" "$@" 3>&1 1>&2 2>&3; }
valid() { [[ "$1" =~ ^[a-z][a-z0-9_-]{0,23}$ ]] && [[ "$1" != *-bots ]] && [ "$1" != root ]; }
while ! valid "$ADMIN_USER"; do
  ADMIN_USER=$(ask --inputbox "Your login name (lowercase letters and digits).\n\nYou'll be an admin. Your Bots get their own locked-down account, never root." 12 64) || ADMIN_USER=
done
while [ ${#ADMIN_PASSWORD} -lt 4 ]; do
  ADMIN_PASSWORD=$(ask --passwordbox "A password for $ADMIN_USER:" 9 60) || ADMIN_PASSWORD=
  [ "$ADMIN_PASSWORD" = "$(ask --passwordbox "The same password again:" 9 60)" ] || ADMIN_PASSWORD=
done
if [ -z "$ROOT_PASSWORD" ]; then
  while [ ${#ROOT_PASSWORD} -lt 4 ]; do
    ROOT_PASSWORD=$(ask --passwordbox "A password for root.\n\nRoot is for the terminal only (su - or sudo -i). It can't log in to the desktop, and Bots never run as root." 12 64) || ROOT_PASSWORD=
  done
fi
[ -n "$HOSTNAME_NEW" ] || HOSTNAME_NEW=$(ask --inputbox "A name for this computer:" 9 60 deskmate-os) || HOSTNAME_NEW=deskmate-os
HOSTNAME_NEW=$(printf '%s' "$HOSTNAME_NEW" | tr -cd 'A-Za-z0-9-' | cut -c1-40); [ -n "$HOSTNAME_NEW" ] || HOSTNAME_NEW=deskmate-os

hostnamectl set-hostname "$HOSTNAME_NEW" 2>/dev/null || echo "$HOSTNAME_NEW" >/etc/hostname
sed -i "/^127.0.1.1/d" /etc/hosts; echo "127.0.1.1 $HOSTNAME_NEW" >>/etc/hosts
printf 'root:%s\n' "$ROOT_PASSWORD" | chpasswd
DESKMATE_PASSWORD="$ADMIN_PASSWORD" /usr/local/bin/deskmate-os user add "$ADMIN_USER" --admin
if [ -n "$HOST_SSH_KEY" ]; then
  printf '%s\n' "$HOST_SSH_KEY" >>"/home/$ADMIN_USER-bots/.ssh/authorized_keys"
fi
# A clone of Deskmate from the host PC (Bots, skills, tools; no sign-ins or
# secrets). Deskmate brings it in the first time this person starts it.
if [ -f /boot/efi/deskmate-clone.bin ]; then
  install -d -o "$ADMIN_USER" -g "$ADMIN_USER" -m 700 "/home/$ADMIN_USER/.deskmate"
  install -o "$ADMIN_USER" -g "$ADMIN_USER" -m 600 /boot/efi/deskmate-clone.bin "/home/$ADMIN_USER/.deskmate/import.dmclone"
  rm -f /boot/efi/deskmate-clone.bin
fi
unset ADMIN_PASSWORD ROOT_PASSWORD
touch "$done_file"
clear
echo "Ready. Log in as $ADMIN_USER."
sleep 1
